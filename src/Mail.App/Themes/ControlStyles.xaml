<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Implicit styles for the controls the app actually uses. Replacing
        individual colours was not enough: most panels never set a Background at
        all, so they fall through to WPF's built-in light defaults and there is
        nothing to override. These give every surface a themed brush.

        Styles are keyless (implicit) so they apply without touching each
        control, and every brush is a DynamicResource so switching theme
        restyles live rather than needing a restart.
    -->

    <Style TargetType="Window">
        <Setter Property="Background" Value="{DynamicResource Chrome.Background}"/>
        <Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/>
    </Style>

    <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/>
    </Style>

    <Style TargetType="Label">
        <Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/>
    </Style>

    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/>
    </Style>

    <Style TargetType="TextBox">
        <Setter Property="Padding" Value="6,3"/>
        <Setter Property="MinHeight" Value="26"/>
        <Setter Property="Background" Value="{DynamicResource Chrome.Background}"/>
        <Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Chrome.Border}"/>
        <Setter Property="CaretBrush" Value="{DynamicResource Text.Primary}"/>
        <Setter Property="SelectionBrush" Value="{DynamicResource Accent}"/>
    </Style>

    <Style TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource Chrome.Raised}"/>
        <Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Chrome.Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <!-- Spacing on a 4px grid throughout, so controls line up without
             each one carrying its own hand-tuned margin. -->
        <Setter Property="Padding" Value="12,4"/>
        <Setter Property="Margin" Value="0,0,4,0"/>
        <Setter Property="MinHeight" Value="26"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <!-- Retemplated because the stock chrome paints its own
                         light gradient regardless of Background. -->
                    <Border x:Name="Chrome" CornerRadius="2"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background"
                                    Value="{DynamicResource Selection.Background}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}"/>
                            <Setter TargetName="Chrome" Property="Opacity" Value="0.6"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBox">
        <Setter Property="Padding" Value="6,3"/>
        <Setter Property="MinHeight" Value="26"/>
        <Setter Property="Background" Value="{DynamicResource Chrome.Raised}"/>
        <Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Chrome.Border}"/>
    </Style>

    <Style TargetType="ListView">
        <Setter Property="Background" Value="{DynamicResource Chrome.Background}"/>
        <Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Chrome.Border}"/>
    </Style>

    <Style TargetType="ListViewItem">
        <Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/>
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{DynamicResource Selection.Background}"/>
                <Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="TreeView">
        <Setter Property="Background" Value="{DynamicResource Chrome.Background}"/>
        <Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Chrome.Border}"/>
    </Style>

    <Style TargetType="TreeViewItem">
        <Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/>
        <Setter Property="Padding" Value="2,1"/>
    </Style>

    <Style TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/>
        <Setter Property="Padding" Value="4,1"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Row.Hover}"/>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{DynamicResource Selection.Background}"/>
                <Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="DataGrid">
        <Setter Property="Background" Value="{DynamicResource Chrome.Background}"/>
        <Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Chrome.Border}"/>
        <Setter Property="RowBackground" Value="{DynamicResource Chrome.Background}"/>
        <Setter Property="AlternatingRowBackground" Value="{DynamicResource Row.Stripe}"/>
        <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource Chrome.BorderSubtle}"/>
        <Setter Property="VerticalGridLinesBrush" Value="{DynamicResource Chrome.BorderSubtle}"/>
    </Style>

    <Style TargetType="DataGridRow">
        <Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/>
        <!-- 22px: dense enough to see a screenful of mail, tall enough that
             rows do not run together. -->
        <Setter Property="MinHeight" Value="22"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Template">
            <Setter.Value>
                <!--
                  Retemplated so the selected row can actually draw an edge. The
                  stock template puts the cells in a SelectiveScrollingGrid that
                  never consumes BorderBrush or BorderThickness, so setting them
                  in a trigger — as this style used to — silently drew nothing.

                  This matters more than it sounds: a selection fill can only be
                  a slight tint, because it has to stay dark enough for the row
                  text to remain readable on top of it. Measured, the fill is
                  about 1.4:1 against the rows around it, which is nowhere near
                  enough on its own. The accent edge is 3.6-4.3:1 in dark and
                  5.1-5.7:1 in light, so the edge is what makes the selection
                  findable and the fill merely confirms it.
                -->
                <ControlTemplate TargetType="DataGridRow">
                    <Border x:Name="RowBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            SnapsToDevicePixels="True">
                        <SelectiveScrollingGrid>
                            <SelectiveScrollingGrid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </SelectiveScrollingGrid.ColumnDefinitions>
                            <SelectiveScrollingGrid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </SelectiveScrollingGrid.RowDefinitions>
                            <DataGridCellsPresenter Grid.Column="1"
                                ItemsPanel="{TemplateBinding ItemsPanel}"
                                SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                            <DataGridDetailsPresenter Grid.Column="1" Grid.Row="1"
                                Visibility="{TemplateBinding DetailsVisibility}"/>
                            <DataGridRowHeader Grid.RowSpan="2"
                                SelectiveScrollingGrid.SelectiveScrollingOrientation="Vertical"
                                Visibility="{Binding HeadersVisibility,
                                    RelativeSource={RelativeSource AncestorType=DataGrid},
                                    Converter={x:Static DataGrid.HeadersVisibilityConverter},
                                    ConverterParameter=Row}"/>
                        </SelectiveScrollingGrid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="RowBorder" Property="Background"
                                    Value="{DynamicResource Row.Hover}"/>
                        </Trigger>
                        <!-- Selection last, so it wins over hover: the row the
                             pointer happens to rest on must not disguise which
                             row is actually selected. -->
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="RowBorder" Property="Background"
                                    Value="{DynamicResource Selection.Background}"/>
                            <Setter TargetName="RowBorder" Property="BorderBrush"
                                    Value="{DynamicResource Selection.Edge}"/>
                            <Setter TargetName="RowBorder" Property="BorderThickness"
                                    Value="3,1,0,1"/>
                            <Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <!-- Lives here rather than on the DataGrid, because an explicit
                 RowStyle would replace this whole style, template included. -->
            <DataTrigger Binding="{Binding IsUnread}" Value="True">
                <Setter Property="FontWeight" Value="Bold"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="DataGridCell">
        <Setter Property="Padding" Value="8,2"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/>
        <Style.Triggers>
            <!-- Stock DataGrid paints selected cells with the system highlight,
                 which ignores the theme entirely. -->
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="{DynamicResource Chrome.Alt}"/>
        <!-- Headers label the data; they should not compete with it. -->
        <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Chrome.BorderSubtle}"/>
        <Setter Property="BorderThickness" Value="0,0,1,1"/>
        <Setter Property="Padding" Value="8,5"/>
        <Setter Property="MinHeight" Value="26"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Template">
            <Setter.Value>
                <!-- Same reason as DataGridRow: the stock header template paints
                     its own light chrome and never uses Background, so in dark
                     mode the header strip stayed white above a dark grid. -->
                <ControlTemplate TargetType="DataGridColumnHeader">
                    <Grid>
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="Center"/>
                        </Border>
                        <!-- Kept so columns stay resizable by dragging the edge. -->
                        <Thumb x:Name="PART_LeftHeaderGripper" HorizontalAlignment="Left"
                               Width="8" Cursor="SizeWE" Opacity="0" Background="Transparent"/>
                        <Thumb x:Name="PART_RightHeaderGripper" HorizontalAlignment="Right"
                               Width="8" Cursor="SizeWE" Opacity="0" Background="Transparent"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="GridViewColumnHeader">
        <Setter Property="Background" Value="{DynamicResource Chrome.Alt}"/>
        <Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Chrome.Border}"/>
    </Style>

    <Style TargetType="TabControl">
        <Setter Property="Background" Value="{DynamicResource Chrome.Background}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Chrome.Border}"/>
    </Style>

    <Style TargetType="TabItem">
        <Setter Property="Background" Value="{DynamicResource Chrome.Alt}"/>
        <Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Chrome.Border}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border x:Name="Chrome" Margin="0,0,2,0" CornerRadius="2,2,0,0"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1,1,1,0">
                        <ContentPresenter ContentSource="Header" Margin="8,3"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Chrome" Property="Background"
                                    Value="{DynamicResource Chrome.Background}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="StatusBar">
        <Setter Property="Background" Value="{DynamicResource Chrome.Alt}"/>
        <Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/>
    </Style>

    <Style TargetType="Menu">
        <Setter Property="Background" Value="{DynamicResource Chrome.Alt}"/>
        <Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/>
        <Setter Property="Template">
            <Setter.Value>
                <!-- The stock Menu template paints a fixed light background over
                     whatever Background is set to, which left a white bar across
                     the top of the window in dark mode. -->
                <ControlTemplate TargetType="Menu">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <ItemsPresenter/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ContextMenu">
        <Setter Property="Background" Value="{DynamicResource Chrome.Raised}"/>
        <Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Chrome.Border}"/>
    </Style>

    <Style TargetType="MenuItem">
        <Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/>
    </Style>

    <Style TargetType="GridSplitter">
        <Setter Property="Background" Value="{DynamicResource Chrome.BorderSubtle}"/>
    </Style>

    <Style TargetType="ProgressBar">
        <Setter Property="Background" Value="{DynamicResource Chrome.Raised}"/>
        <Setter Property="Foreground" Value="{DynamicResource Status.Good}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Chrome.Border}"/>
    </Style>

    <Style TargetType="ScrollViewer">
        <Setter Property="Background" Value="{DynamicResource Chrome.Background}"/>
    </Style>

    <Style TargetType="ItemsControl">
        <Setter Property="Background" Value="{DynamicResource Chrome.Background}"/>
    </Style>

    <Style TargetType="Separator">
        <Setter Property="Background" Value="{DynamicResource Chrome.Border}"/>
    </Style>

</ResourceDictionary>
