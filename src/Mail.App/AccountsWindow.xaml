<Window x:Class="Mail.App.AccountsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime"
        Title="Accounts &amp; sync" Height="440" Width="980" FontSize="12"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Window.Resources>
        <x:Array x:Key="Policies" Type="sys:String">
            <sys:String>MirrorServer</sys:String>
            <sys:String>WindowedCache</sys:String>
        </x:Array>
    </Window.Resources>
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DataGrid x:Name="MailboxGrid" Grid.Row="0" AutoGenerateColumns="False"
                  CanUserAddRows="False" CanUserDeleteRows="False" RowHeaderWidth="0"
                  GridLinesVisibility="Horizontal" HeadersVisibility="Column">
            <DataGrid.Columns>
                <DataGridCheckBoxColumn Header="Enabled" Binding="{Binding Enabled}" Width="60"/>
                <DataGridTextColumn Header="Mailbox (UPN)" Binding="{Binding Upn}" Width="240" IsReadOnly="True"/>
                <DataGridTextColumn Header="Kind" Binding="{Binding Kind}" Width="70" IsReadOnly="True"/>
                <DataGridComboBoxColumn Header="Sync policy" Width="120"
                                        ItemsSource="{StaticResource Policies}"
                                        SelectedItemBinding="{Binding Policy}"/>
                <DataGridTextColumn Header="Months" Binding="{Binding MonthsText}" Width="60"/>
                <DataGridTextColumn Header="Messages" Binding="{Binding Messages}" Width="80" IsReadOnly="True"/>
                <DataGridTextColumn Header="DB size" Binding="{Binding DbSize}" Width="90" IsReadOnly="True"/>
                <DataGridTextColumn Header="Database file" Binding="{Binding DbPath}" Width="*" IsReadOnly="True"/>
            </DataGrid.Columns>
        </DataGrid>

        <DockPanel Grid.Row="1" Margin="0,8,0,0">
            <TextBlock x:Name="StatusLabel" VerticalAlignment="Center" Foreground="Gray"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Add account…" Padding="10,3" Margin="0,0,8,0" Click="OnAddAccount"/>
                <Button Content="Reset sync state" Padding="10,3" Margin="0,0,8,0" Click="OnResetSync"
                        ToolTip="Clears the selected mailbox's delta checkpoints; next sync re-lists (stored mail is not re-downloaded)."/>
                <Button Content="Save" Padding="14,3" Margin="0,0,8,0" Click="OnSave"/>
                <Button Content="Close" Padding="12,3" Click="OnCloseClick"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
