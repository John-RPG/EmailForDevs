<Window x:Class="Mail.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="eeeMail (dev)" Height="850" Width="1500" FontSize="12"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="4,4,4,2">
            <Button DockPanel.Dock="Right" Content="Search" Click="OnSearchClick"
                    Margin="4,0,0,0" Padding="10,2"/>
            <TextBox x:Name="SearchBox" KeyDown="OnSearchKeyDown"
                     VerticalContentAlignment="Center">
                <TextBox.ToolTip>
                    <TextBlock>
                        Search (Enter). Bare words are full text; empty returns to the folder.<LineBreak/>
                        <LineBreak/>
                        <Bold>People</Bold>  from: to: cc: bcc: recipient: participant:<LineBreak/>
                        <Bold>Content</Bold>  subject: body: filename: in:<LineBreak/>
                        <Bold>State</Bold>  is:unread is:read is:flagged is:draft has:attachment<LineBreak/>
                        <Bold>Dates</Bold>  after: before: on:  — 2026-08-31, 2026-08, today, 7d, 3m<LineBreak/>
                        <Bold>Size</Bold>  larger:2mb smaller:500kb<LineBreak/>
                        <Bold>Logic</Bold>  AND (implicit), OR, NOT or -, ( ), "quoted phrases"<LineBreak/>
                        <Bold>Wildcards</Bold>  * and ? in field values (anchored: from:*@corp.com,<LineBreak/>
                        filename:*.pdf, subject:*report*); trailing * on bare words (invoic*).<LineBreak/>
                        Escape with a backslash for literals: \* \? \\<LineBreak/>
                        <LineBreak/>
                        Example: from:alice has:attachment after:3m -subject:"weekly report"
                    </TextBlock>
                </TextBox.ToolTip>
            </TextBox>
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" MinWidth="150"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*" MinWidth="400"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TreeView x:Name="FolderTree" Grid.Row="0"
                          SelectedItemChanged="OnFolderSelected" BorderThickness="0,1,0,0"/>
                <Expander Grid.Row="1" Header="Activity log" IsExpanded="True"
                          BorderThickness="0,1,0,0">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="2">
                            <ToggleButton x:Name="FltDebug" Content="⚙" ToolTip="Debug"
                                          Padding="6,0" Margin="1,0" Click="OnLogFilterChanged"/>
                            <ToggleButton x:Name="FltVerbose" Content="·" ToolTip="Verbose" IsChecked="True"
                                          Padding="8,0" Margin="1,0" Click="OnLogFilterChanged"/>
                            <ToggleButton x:Name="FltInfo" Content="ℹ" ToolTip="Info" IsChecked="True"
                                          Padding="7,0" Margin="1,0" Click="OnLogFilterChanged"/>
                            <ToggleButton x:Name="FltWarning" Content="⚠" ToolTip="Warning" IsChecked="True"
                                          Padding="6,0" Margin="1,0" Click="OnLogFilterChanged"/>
                            <ToggleButton x:Name="FltError" Content="✖" ToolTip="Error" IsChecked="True"
                                          Padding="6,0" Margin="1,0" Click="OnLogFilterChanged"/>
                            <Button Content="Clear" Margin="8,0,0,0" Padding="6,0" Click="OnLogClear"/>
                        </StackPanel>
                        <ListBox x:Name="ActivityLog" Height="170" FontFamily="Consolas"
                                 FontSize="11" BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Auto">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="2,0"/>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Display}" Foreground="{Binding Brush}"
                                               ToolTip="{Binding Message}"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Expander>
            </Grid>

            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Center"
                          VerticalAlignment="Stretch" ShowsPreview="True"/>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" MinHeight="120"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*" MinHeight="120"/>
                </Grid.RowDefinitions>

                <DataGrid x:Name="MessageGrid" Grid.Row="0"
                          AutoGenerateColumns="False" IsReadOnly="True"
                          SelectionMode="Extended" SelectionUnit="FullRow"
                          GridLinesVisibility="None" RowHeaderWidth="0"
                          BorderThickness="0,1,0,0" HeadersVisibility="Column"
                          EnableRowVirtualization="True"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          CanUserAddRows="False" CanUserDeleteRows="False"
                          SelectionChanged="OnMessageSelected"
                          PreviewKeyDown="OnGridKeyDown">
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsUnread}" Value="True">
                                    <Setter Property="FontWeight" Value="Bold"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn x:Name="ColStatus" Header=""
                                            Binding="{Binding Status}" Width="Auto"
                                            CanUserResize="False"/>
                        <DataGridTextColumn x:Name="ColFrom" Header="From"
                                            Binding="{Binding From}" Width="Auto"/>
                        <DataGridTextColumn x:Name="ColFromName" Header="From Name"
                                            Binding="{Binding FromName}" Width="Auto" Visibility="Collapsed"/>
                        <DataGridTextColumn x:Name="ColFromAddress" Header="From Address"
                                            Binding="{Binding FromAddress}" Width="Auto" Visibility="Collapsed"/>
                        <DataGridTextColumn x:Name="ColTo" Header="To"
                                            Binding="{Binding To}" Width="Auto"/>
                        <DataGridTextColumn x:Name="ColReceived" Header="Received"
                                            Binding="{Binding Received}" Width="Auto"/>
                        <DataGridTextColumn x:Name="ColSize" Header="KB"
                                            Binding="{Binding SizeKb}" Width="Auto"
                                            SortMemberPath="SizeVal">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextAlignment" Value="Right"/>
                                    <Setter Property="Margin" Value="0,0,6,0"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn x:Name="ColSubject" Header="Subject"
                                            Binding="{Binding Subject}" Width="*"/>
                    </DataGrid.Columns>
                    <DataGrid.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Mark read" Click="OnMarkRead"/>
                            <MenuItem Header="Mark unread" Click="OnMarkUnread"/>
                            <MenuItem Header="Delete" InputGestureText="Del" Click="OnDeleteMessages"/>
                            <MenuItem x:Name="MoveToMenu" Header="Move to" SubmenuOpened="OnMoveToOpened">
                                <MenuItem Header="(loading…)"/>
                            </MenuItem>
                            <Separator/>
                            <MenuItem x:Name="ColumnsMenu" Header="Columns"/>
                        </ContextMenu>
                    </DataGrid.ContextMenu>
                </DataGrid>

                <GridSplitter Grid.Row="1" Height="5" HorizontalAlignment="Stretch"
                              VerticalAlignment="Center" ShowsPreview="True"/>

                <Grid Grid.Row="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBox x:Name="EnvelopeText" Grid.Row="0" IsReadOnly="True"
                             BorderThickness="0,1,0,1" FontFamily="Consolas"
                             TextWrapping="Wrap" MaxHeight="120"
                             VerticalScrollBarVisibility="Auto" Background="Transparent"/>
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="200"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*" MinWidth="200"/>
                        </Grid.ColumnDefinitions>
                        <TabControl x:Name="ReadingTabs" Grid.Column="0" BorderThickness="0">
                            <TabItem Header="Text">
                                <TextBox x:Name="BodyText" IsReadOnly="True" TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto" FontFamily="Consolas"
                                         BorderThickness="0"/>
                            </TabItem>
                            <TabItem Header="HTML">
                                <TextBox x:Name="HtmlSourceText" IsReadOnly="True" TextWrapping="NoWrap"
                                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                         FontFamily="Consolas" BorderThickness="0"/>
                            </TabItem>
                            <TabItem Header="Headers">
                                <TextBox x:Name="HeadersText" IsReadOnly="True" TextWrapping="NoWrap"
                                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                         FontFamily="Consolas" BorderThickness="0"/>
                            </TabItem>
                            <TabItem Header="MIME">
                                <TextBox x:Name="RawText" IsReadOnly="True" TextWrapping="NoWrap"
                                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                         FontFamily="Consolas" BorderThickness="0"/>
                            </TabItem>
                            <TabItem Header="Attachments">
                                <ListView x:Name="AttachmentList" BorderThickness="0"
                                          MouseDoubleClick="OnAttachmentSave"
                                          ToolTip="Double-click an attachment to save it">
                                    <ListView.View>
                                        <GridView>
                                            <GridViewColumn Header="Name" Width="260"
                                                            DisplayMemberBinding="{Binding Name}"/>
                                            <GridViewColumn Header="Type" Width="170"
                                                            DisplayMemberBinding="{Binding ContentType}"/>
                                            <GridViewColumn Header="KB" Width="70"
                                                            DisplayMemberBinding="{Binding SizeKb}"/>
                                            <GridViewColumn Header="Inline" Width="50"
                                                            DisplayMemberBinding="{Binding Inline}"/>
                                        </GridView>
                                    </ListView.View>
                                </ListView>
                            </TabItem>
                        </TabControl>
                        <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Center"
                                      VerticalAlignment="Stretch" ShowsPreview="True"/>
                        <wv2:WebView2 x:Name="PreviewView" Grid.Column="2"/>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>

        <StatusBar Grid.Row="2">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="Opening profile…"/>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="ScanLabel" Margin="0,0,12,0" VerticalAlignment="Center"
                               Foreground="Gray"/>
                    <TextBlock x:Name="SyncLabel" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <ProgressBar x:Name="SyncBar" Width="180" Height="14" VerticalAlignment="Center"/>
                    <Button x:Name="SyncButton" Content="Sync now" Margin="8,0,0,0"
                            Padding="8,1" Click="OnSyncClick"/>
                    <Button x:Name="AccountsButton" Content="Accounts…" Margin="6,0,0,0"
                            Padding="8,1" Click="OnAccountsClick"/>
                </StackPanel>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
