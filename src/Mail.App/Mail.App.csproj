<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <EmbeddedResource Include="Assets\editor.html" />
    <!-- Resource, not EmbeddedResource: window icons are loaded through a
         pack:// URI, which reads the WPF resource table rather than the
         assembly's manifest resources. -->
    <Resource Include="Assets\icon.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Mail.Core\Mail.Core.csproj" />
    <ProjectReference Include="..\Mail.Storage\Mail.Storage.csproj" />
    <ProjectReference Include="..\Mail.Sync\Mail.Sync.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Dirkster.AvalonDock" Version="5.0.0" />
    <PackageReference Include="Dirkster.AvalonDock.Serializer.Xml" Version="5.0.0" />
    <PackageReference Include="Dirkster.AvalonDock.Themes.VS2013" Version="5.0.0" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4191.47" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>eeeMail</AssemblyName>
    <ApplicationIcon>Assets\icon.ico</ApplicationIcon>

    <!-- Every build gets a new, higher version: Major.Minor are set by hand
         here, and the last two parts are stamped from the clock at build time -
         days since 2000-01-01, then half-seconds since midnight, both UTC.
         The same scheme as the "1.0.*" wildcard, but in UTC so a daylight-
         saving change cannot make a later build number lower, and applied to
         every version attribute rather than only AssemblyVersion. One clock
         reading feeds both parts, so a build at midnight cannot pair one day's
         date with the next day's time. The release is tagged from the built
         exe's version, so nothing needs bumping by hand. -->
    <VersionMajorMinor>1.0</VersionMajorMinor>
    <_StampTicks>$([System.DateTime]::UtcNow.Ticks)</_StampTicks>
    <_StampSince2000>$([MSBuild]::Subtract($(_StampTicks), 630822816000000000))</_StampSince2000>
    <_StampDays>$([System.Math]::Floor($([MSBuild]::Divide($(_StampSince2000), 864000000000))))</_StampDays>
    <_StampHalfSeconds>$([System.Math]::Floor($([MSBuild]::Divide($([MSBuild]::Modulo($(_StampSince2000), 864000000000)), 20000000))))</_StampHalfSeconds>
    <Version>$(VersionMajorMinor).$(_StampDays).$(_StampHalfSeconds)</Version>
    <Product>eeeMail</Product>
    <Company>John Hadlow</Company>
  </PropertyGroup>

  <!-- Publish profile for releases: one self-contained file that runs on a
       machine with no .NET installed. Not compressed, because a compressed
       single file extracts to temp on every launch. Trimming is off: WPF and
       the Graph SDK both reflect over types the trimmer cannot see. -->
  <PropertyGroup Condition="'$(PublishSingleFile)' == 'true'">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

</Project>
