<Window x:Class="Mail.App.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Update available" Height="560" Width="620" FontSize="12"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource Chrome.Background}"
        Foreground="{DynamicResource Text.Primary}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="Headline" Grid.Row="0" FontSize="17" FontWeight="SemiBold"
                   TextWrapping="Wrap" Margin="0,0,0,10"/>

        <!-- What is about to be run, before it is run. The digest is shown
             because an unsigned binary has nothing else to identify it by. -->
        <Border Grid.Row="1" Background="{DynamicResource Chrome.Alt}"
                BorderBrush="{DynamicResource Chrome.Border}" BorderThickness="1"
                Padding="10" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock x:Name="AssetLine" FontFamily="Consolas" TextWrapping="Wrap"/>
                <TextBlock x:Name="DigestLine" FontFamily="Consolas" TextWrapping="Wrap"
                           Foreground="{DynamicResource Text.Secondary}" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <TextBox x:Name="NotesText" Grid.Row="2" IsReadOnly="True" TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto" BorderThickness="1"
                 BorderBrush="{DynamicResource Chrome.Border}" Padding="8"
                 Background="{DynamicResource Chrome.Background}"
                 AutomationProperties.Name="Release notes"/>

        <StackPanel Grid.Row="3" Margin="0,12,0,0">
            <ProgressBar x:Name="Progress" Height="6" Visibility="Collapsed"/>
            <TextBlock x:Name="StatusLine" TextWrapping="Wrap" Margin="0,6,0,0"
                       Foreground="{DynamicResource Text.Secondary}"/>
        </StackPanel>

        <DockPanel Grid.Row="4" Margin="0,14,0,0">
            <Button x:Name="ViewButton" DockPanel.Dock="Left" Content="View on GitHub"
                    Padding="12,4" Click="OnViewRelease"/>
            <Button x:Name="InstallButton" DockPanel.Dock="Right" Content="Download and install"
                    Padding="14,4" Margin="8,0,0,0" IsDefault="True" Click="OnInstall"
                    AutomationProperties.AutomationId="update-install"/>
            <Button x:Name="LaterButton" DockPanel.Dock="Right" Content="Not now"
                    Padding="14,4" IsCancel="True" Click="OnLater"/>
            <TextBlock/>
        </DockPanel>
    </Grid>
</Window>
