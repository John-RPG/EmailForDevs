<Window x:Class="Mail.App.SharedMailboxWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add shared mailbox" Height="560" Width="760"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" TextWrapping="Wrap" Foreground="Gray" Margin="0,0,0,10">
            Mailboxes Exchange has mapped to the account are listed first and can be added
            straight away. Anything below those is a suggestion, so its access is checked
            when you select it. If a mailbox you have rights to is missing, search the
            directory or type its address.
        </TextBlock>

        <DockPanel Grid.Row="1" Margin="0,0,0,8">
            <TextBlock Text="Account:" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <ComboBox x:Name="AccountCombo" Width="240" DockPanel.Dock="Left"
                      SelectionChanged="OnAccountChanged"/>
            <Button Content="Refresh" DockPanel.Dock="Right" Padding="10,3"
                    Click="OnRefresh"/>
            <TextBox x:Name="SearchBox" Margin="10,0,8,0"
                     KeyDown="OnSearchKeyDown"
                     ToolTip="Search the directory by name or address, then press Enter."/>
        </DockPanel>

        <DataGrid x:Name="CandidateGrid" Grid.Row="2" AutoGenerateColumns="False"
                  CanUserAddRows="False" CanUserDeleteRows="False" RowHeaderWidth="0"
                  IsReadOnly="True" GridLinesVisibility="Horizontal"
                  HeadersVisibility="Column" SelectionMode="Single"
                  SelectionChanged="OnCandidateSelected">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Name" Binding="{Binding DisplayName}" Width="220"/>
                <DataGridTextColumn Header="Address" Binding="{Binding Address}" Width="260"/>
                <DataGridTextColumn Header="Found via" Binding="{Binding Source}" Width="90"/>
                <DataGridTextColumn Header="Access" Binding="{Binding Access}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <DockPanel Grid.Row="3" Margin="0,8,0,0">
            <TextBlock Text="Address:" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <Button x:Name="CheckButton" Content="Check access" DockPanel.Dock="Right"
                    Padding="10,3" Margin="8,0,0,0" Click="OnCheckAccess"/>
            <TextBox x:Name="AddressBox" VerticalContentAlignment="Center"/>
        </DockPanel>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right"
                    Margin="0,10,0,0">
            <Button x:Name="AddButton" Content="Add mailbox" Padding="14,3"
                    Margin="0,0,8,0" IsEnabled="False" Click="OnAdd"
                    AutomationProperties.AutomationId="picker-add"/>
            <Button Content="Close" Padding="12,3" Click="OnClose"
                    AutomationProperties.AutomationId="picker-close"/>
        </StackPanel>

        <!-- Its own row: the status line explains why a mailbox cannot be added,
             which is long, and must never be painted over by the buttons. -->
        <TextBlock x:Name="StatusLabel" Grid.Row="5" Margin="0,6,0,0"
                   Foreground="Gray" TextWrapping="Wrap"/>
    </Grid>
</Window>
