<Window x:Class="Mail.App.ScopePickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Choose folders to search" Height="560" Width="480" FontSize="12"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource Chrome.Background}"
        Foreground="{DynamicResource Text.Primary}">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" TextWrapping="Wrap"
                   Foreground="{DynamicResource Text.Secondary}"
                   Text="Tick the folders to search. Ticking a mailbox takes all of its folders; ticking a folder with subfolders takes those too."/>

        <DockPanel Grid.Row="1" Margin="0,10,0,8">
            <Button DockPanel.Dock="Left" Content="Select all" Padding="10,2"
                    Click="OnSelectAll"
                    AutomationProperties.AutomationId="scope-selectall"/>
            <Button DockPanel.Dock="Left" Content="Clear" Padding="10,2" Margin="6,0,0,0"
                    Click="OnClear"
                    AutomationProperties.AutomationId="scope-clear"/>
            <TextBlock x:Name="CountText" VerticalAlignment="Center" Margin="10,0,0,0"
                       Foreground="{DynamicResource Text.Secondary}"/>
        </DockPanel>

        <Border Grid.Row="2" BorderBrush="{DynamicResource Border}" BorderThickness="1">
            <TreeView x:Name="Tree" BorderThickness="0"
                      Background="{DynamicResource Chrome.Alt}"
                      AutomationProperties.Name="Folders"
                      AutomationProperties.AutomationId="scope-tree">
                <TreeView.ItemTemplate>
                    <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                        <StackPanel Orientation="Horizontal">
                            <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                      VerticalAlignment="Center"
                                      AutomationProperties.Name="{Binding Name}"/>
                            <TextBlock Text="{Binding Name}" Margin="6,0,0,0"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource Text.Primary}"/>
                        </StackPanel>
                    </HierarchicalDataTemplate>
                </TreeView.ItemTemplate>
                <TreeView.ItemContainerStyle>
                    <Style TargetType="TreeViewItem">
                        <!-- Expanded by default: a picker that hides the folders
                             behind a disclosure arrow makes the common case, a
                             couple of folders in one mailbox, needlessly slow. -->
                        <Setter Property="IsExpanded" Value="True"/>
                        <Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/>
                    </Style>
                </TreeView.ItemContainerStyle>
            </TreeView>
        </Border>

        <DockPanel Grid.Row="3" Margin="0,12,0,0">
            <Button DockPanel.Dock="Right" Content="Cancel" Padding="16,4" Margin="8,0,0,0"
                    IsCancel="True"
                    AutomationProperties.AutomationId="scope-cancel"/>
            <Button x:Name="OkButton" DockPanel.Dock="Right" Content="Search these"
                    Padding="18,4" IsDefault="True" Click="OnOk"
                    AutomationProperties.AutomationId="scope-ok"/>
            <TextBlock/>
        </DockPanel>
    </Grid>
</Window>
