<Window x:Class="Mail.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:local="clr-namespace:Mail.App"
        Title="eeeMail (dev)" Height="850" Width="1500" FontSize="12"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
                    
                        <Style x:Key="FolderRowStyle" TargetType="TreeViewItem">
                            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                            <Setter Property="Visibility" Value="{Binding Visibility}"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                            <Setter Property="Padding" Value="1,1"/>
                            <!--
                              The stock TreeViewItem template sizes its header to
                              content, so a Stretch on the row alone never reaches
                              the item. Retemplating gives the header a real column
                              that fills the remaining width, which is what lets the
                              count column sit hard right and the name ellipsize.
                            -->
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="TreeViewItem">
                                        <StackPanel>
                                            <Border x:Name="Row"
                                                    Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    Padding="{TemplateBinding Padding}"
                                                    SnapsToDevicePixels="True">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="19"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <ToggleButton x:Name="Expander" Grid.Column="0"
                                                                  ClickMode="Press"
                                                                  IsChecked="{Binding IsExpanded,
                                                                      RelativeSource={RelativeSource TemplatedParent}}">
                                                        <ToggleButton.Style>
                                                            <Style TargetType="ToggleButton">
                                                                <Setter Property="Focusable" Value="False"/>
                                                                <Setter Property="Width" Value="16"/>
                                                                <Setter Property="Height" Value="16"/>
                                                                <Setter Property="Template">
                                                                    <Setter.Value>
                                                                        <ControlTemplate TargetType="ToggleButton">
                                                                            <Border Background="Transparent"
                                                                                    Width="16" Height="16">
                                                                                <Path x:Name="Arrow"
                                                                                      HorizontalAlignment="Center"
                                                                                      VerticalAlignment="Center"
                                                                                      Data="M 0 0 L 4 4 L 0 8 Z"
                                                                                      Fill="#FF666666"/>
                                                                            </Border>
                                                                            <ControlTemplate.Triggers>
                                                                                <Trigger Property="IsChecked" Value="True">
                                                                                    <Setter TargetName="Arrow"
                                                                                            Property="Data"
                                                                                            Value="M 0 2 L 8 2 L 4 6 Z"/>
                                                                                </Trigger>
                                                                            </ControlTemplate.Triggers>
                                                                        </ControlTemplate>
                                                                    </Setter.Value>
                                                                </Setter>
                                                            </Style>
                                                        </ToggleButton.Style>
                                                    </ToggleButton>
                                                    <ContentPresenter x:Name="PART_Header" Grid.Column="1"
                                                                      ContentSource="Header"
                                                                      HorizontalAlignment="Stretch"/>
                                                </Grid>
                                            </Border>
                                            <ItemsPresenter x:Name="ItemsHost" Margin="12,0,0,0"/>
                                        </StackPanel>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsExpanded" Value="False">
                                                <Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed"/>
                                            </Trigger>
                                            <Trigger Property="HasItems" Value="False">
                                                <Setter TargetName="Expander" Property="Visibility" Value="Hidden"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Row" Property="Background" Value="#FF0078D7"/>
                                                <Setter Property="Foreground" Value="White"/>
                                            </Trigger>
                                            <MultiTrigger>
                                                <MultiTrigger.Conditions>
                                                    <Condition Property="IsMouseOver" Value="True"/>
                                                    <Condition Property="IsSelected" Value="False"/>
                                                </MultiTrigger.Conditions>
                                                <Setter TargetName="Row" Property="Background" Value="#FFE5F3FB"/>
                                            </MultiTrigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    
                    
                        <HierarchicalDataTemplate x:Key="FolderRowTemplate" ItemsSource="{Binding Children}">
                            <Grid Background="Transparent" ToolTip="{Binding Tooltip}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <!-- Auto, not a shared size group. A shared group
                                         makes every row reserve the widest row's number
                                         column, so a folder with no counts still lost
                                         ~100px and truncated its name for nothing. The
                                         cells collapse when empty (see NumberVisibility),
                                         which hands the space back to the name. -->
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Icon}" Margin="0,0,5,0"
                                           VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding DisplayName}"
                                           TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center"
                                           FontWeight="{Binding Weight}"/>
                                <TextBlock Grid.Column="2" Text="{Binding Totals}"
                                           Foreground="Gray"
                                           VerticalAlignment="Center"
                                           TextAlignment="Right" Margin="8,0,0,0"
                                           Visibility="{Binding TotalsVisibility}"/>
                                <TextBlock Grid.Column="3" Text="{Binding Counts}"
                                           Foreground="{Binding CountBrush}"
                                           FontWeight="{Binding Weight}"
                                           VerticalAlignment="Center"
                                           TextAlignment="Right" MinWidth="30" Margin="6,0,4,0"
                                           Visibility="{Binding CountsVisibility}"/>
                                <Grid.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Add to favourites" Click="OnAddFavourite"/>
                                        <MenuItem Header="Remove from favourites" Click="OnRemoveFavourite"/>
                                        <Separator/>
                                        <MenuItem Header="Expand all" Click="OnExpandAll"/>
                                        <MenuItem Header="Collapse all" Click="OnCollapseAll"/>
                                    </ContextMenu>
                                </Grid.ContextMenu>
                            </Grid>
                        </HierarchicalDataTemplate>
                    
    </Window.Resources>
    <Window.InputBindings>
        <KeyBinding Key="N" Modifiers="Ctrl" Command="{x:Static local:MainWindow.ComposeCommand}"/>
        <KeyBinding Key="R" Modifiers="Ctrl" Command="{x:Static local:MainWindow.ReplyCommand}"/>
        <KeyBinding Key="R" Modifiers="Ctrl+Shift" Command="{x:Static local:MainWindow.ReplyAllCommand}"/>
        <KeyBinding Key="F" Modifiers="Ctrl" Command="{x:Static local:MainWindow.ForwardCommand}"/>
        <KeyBinding Key="Delete" Command="{x:Static local:MainWindow.DeleteCommand}"/>
        <KeyBinding Key="Q" Modifiers="Ctrl" Command="{x:Static local:MainWindow.MarkReadCommand}"/>
        <KeyBinding Key="U" Modifiers="Ctrl" Command="{x:Static local:MainWindow.MarkUnreadCommand}"/>
        <KeyBinding Key="F5" Command="{x:Static local:MainWindow.SyncCommand}"/>
        <KeyBinding Key="OemComma" Modifiers="Ctrl" Command="{x:Static local:MainWindow.SettingsCommand}"/>
        <KeyBinding Key="E" Modifiers="Ctrl" Command="{x:Static local:MainWindow.FocusSearchCommand}"/>
    </Window.InputBindings>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="4,4,4,2">
            <!-- Compose actions, then actions on the selected message. Delete,
                 mark read and move were reachable only from the context menu,
                 so a new user could not find them at all. -->
            <Button DockPanel.Dock="Left" Content="New" Click="OnComposeNew"
                    Margin="0,0,4,0" Padding="12,2" ToolTip="New message (Ctrl+N)"
                    AutomationProperties.AutomationId="cmd-new"/>
            <Button DockPanel.Dock="Left" Content="Reply" Click="OnReply"
                    Margin="0,0,4,0" Padding="10,2" ToolTip="Reply (Ctrl+R)"
                    AutomationProperties.AutomationId="cmd-reply"/>
            <Button DockPanel.Dock="Left" Content="Reply all" Click="OnReplyAll"
                    Margin="0,0,4,0" Padding="10,2" ToolTip="Reply all (Ctrl+Shift+R)"
                    AutomationProperties.AutomationId="cmd-replyall"/>
            <Button DockPanel.Dock="Left" Content="Forward" Click="OnForward"
                    Margin="0,0,10,0" Padding="10,2" ToolTip="Forward (Ctrl+F)"
                    AutomationProperties.AutomationId="cmd-forward"/>

            <Separator DockPanel.Dock="Left" Margin="0,2,10,2"/>

            <Button DockPanel.Dock="Left" Content="Delete" Click="OnDeleteMessages"
                    Margin="0,0,4,0" Padding="10,2"
                    ToolTip="Move to Deleted Items (Del)"
                    AutomationProperties.AutomationId="cmd-delete"/>
            <Button DockPanel.Dock="Left" Content="Read" Click="OnMarkRead"
                    Margin="0,0,4,0" Padding="10,2" ToolTip="Mark as read (Ctrl+Q)"
                    AutomationProperties.AutomationId="cmd-read"/>
            <Button DockPanel.Dock="Left" Content="Unread" Click="OnMarkUnread"
                    Margin="0,0,10,0" Padding="10,2" ToolTip="Mark as unread (Ctrl+U)"
                    AutomationProperties.AutomationId="cmd-unread"/>

            <Button DockPanel.Dock="Right" Content="Search" Click="OnSearchClick"
                    Margin="4,0,0,0" Padding="10,2"
                    AutomationProperties.AutomationId="cmd-search"/>
            <Button x:Name="SettingsButton" DockPanel.Dock="Right" Content="Settings…"
                    Click="OnSettingsClick" Margin="4,0,0,0" Padding="10,2"
                    ToolTip="Accounts, permissions, sync and display settings (Ctrl+,)"
                    AutomationProperties.AutomationId="cmd-settings"/>
            <TextBox x:Name="SearchBox" KeyDown="OnSearchKeyDown"
                     VerticalContentAlignment="Center"
                     AutomationProperties.Name="Search">
                <TextBox.ToolTip>
                    <TextBlock>
                        Search (Enter). Bare words are full text; empty returns to the folder.<LineBreak/>
                        <LineBreak/>
                        <Bold>People</Bold>  from: to: cc: bcc: recipient: participant:<LineBreak/>
                        <Bold>Content</Bold>  subject: body: filename: in:<LineBreak/>
                        <Bold>State</Bold>  is:unread is:read is:flagged is:draft has:attachment<LineBreak/>
                        <Bold>Dates</Bold>  after: before: on:  — 2026-08-31, 2026-08, today, 7d, 3m<LineBreak/>
                        <Bold>Size</Bold>  larger:2mb smaller:500kb<LineBreak/>
                        <Bold>Logic</Bold>  AND (implicit), OR, NOT or -, ( ), "quoted phrases"<LineBreak/>
                        <Bold>Wildcards</Bold>  * and ? in field values (anchored: from:*@corp.com,<LineBreak/>
                        filename:*.pdf, subject:*report*); trailing * on bare words (invoic*).<LineBreak/>
                        Escape with a backslash for literals: \* \? \\<LineBreak/>
                        <LineBreak/>
                        Example: from:alice has:attachment after:3m -subject:"weekly report"
                    </TextBlock>
                </TextBox.ToolTip>
            </TextBox>
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" MinWidth="150"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*" MinWidth="400"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*" MinHeight="80"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="200" MinHeight="40"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="4,2">
                    <ToggleButton x:Name="HideQuietToggle" Content="Hide quiet"
                                  Padding="6,1" Click="OnHideQuietChanged"
                                  ToolTip="Hide folders with nothing received in the last month (favourites and folders with unread mail always stay)"/>
                    <Button Content="Expand" Padding="6,1" Margin="4,0,0,0" Click="OnExpandAll"/>
                    <Button Content="Collapse" Padding="6,1" Margin="4,0,0,0" Click="OnCollapseAll"/>
                </StackPanel>

                <TextBlock x:Name="FavouritesHeader" Grid.Row="1" Text="  ★ Favourites"
                           Background="#FFEFEFEF" Foreground="#FF444444" Padding="2,3"
                           FontWeight="Bold" Visibility="Collapsed"/>

                <TreeView x:Name="FavouritesTree" Grid.Row="2"
                          SelectedItemChanged="OnFavouriteSelected" BorderThickness="0,1,0,0"
                          Grid.IsSharedSizeScope="True"
                          MaxHeight="220"
                          Visibility="Collapsed"
                          HorizontalContentAlignment="Stretch"
                          VerticalContentAlignment="Center"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          ItemContainerStyle="{DynamicResource FolderRowStyle}"
                          ItemTemplate="{DynamicResource FolderRowTemplate}"/>

                <GridSplitter Grid.Row="3" Height="4" HorizontalAlignment="Stretch"
                              VerticalAlignment="Center" ShowsPreview="True"
                              Visibility="Collapsed" x:Name="FavouritesSplitter"/>

                <TreeView x:Name="FolderTree" Grid.Row="4"
                          SelectedItemChanged="OnFolderSelected" BorderThickness="0,1,0,0"
                          ItemContainerStyle="{DynamicResource FolderRowStyle}"
                          ItemTemplate="{DynamicResource FolderRowTemplate}"
                          Grid.IsSharedSizeScope="True"
                          HorizontalContentAlignment="Stretch"
                          VerticalContentAlignment="Center"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>

                <GridSplitter Grid.Row="5" Height="5" HorizontalAlignment="Stretch"
                              VerticalAlignment="Center" ShowsPreview="True"/>

                <Expander Grid.Row="6" Header="Activity log" IsExpanded="True"
                          BorderThickness="0,1,0,0">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="2">
                            <ToggleButton x:Name="FltDebug" Content="⚙" ToolTip="Debug"
                                          Padding="6,0" Margin="1,0" Click="OnLogFilterChanged"/>
                            <ToggleButton x:Name="FltVerbose" Content="·" ToolTip="Verbose" IsChecked="True"
                                          Padding="8,0" Margin="1,0" Click="OnLogFilterChanged"/>
                            <ToggleButton x:Name="FltInfo" Content="ℹ" ToolTip="Info" IsChecked="True"
                                          Padding="7,0" Margin="1,0" Click="OnLogFilterChanged"/>
                            <ToggleButton x:Name="FltWarning" Content="⚠" ToolTip="Warning" IsChecked="True"
                                          Padding="6,0" Margin="1,0" Click="OnLogFilterChanged"/>
                            <ToggleButton x:Name="FltError" Content="✖" ToolTip="Error" IsChecked="True"
                                          Padding="6,0" Margin="1,0" Click="OnLogFilterChanged"/>
                            <Button Content="Clear" Margin="8,0,0,0" Padding="6,0" Click="OnLogClear"/>
                        </StackPanel>
                        <ListBox x:Name="ActivityLog" MinHeight="60" FontFamily="Consolas"
                                 FontSize="11" BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Auto">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="2,0"/>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Display}" Foreground="{Binding Brush}"
                                               ToolTip="{Binding Message}"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Expander>
            </Grid>

            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Center"
                          VerticalAlignment="Stretch" ShowsPreview="True"/>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" MinHeight="120"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*" MinHeight="120"/>
                </Grid.RowDefinitions>

                <DataGrid x:Name="MessageGrid" Grid.Row="0"
                          AutoGenerateColumns="False" IsReadOnly="True"
                          SelectionMode="Extended" SelectionUnit="FullRow"
                          GridLinesVisibility="None" RowHeaderWidth="0"
                          BorderThickness="0,1,0,0" HeadersVisibility="Column"
                          EnableRowVirtualization="True"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          CanUserAddRows="False" CanUserDeleteRows="False"
                          SelectionChanged="OnMessageSelected"
                          PreviewKeyDown="OnGridKeyDown">
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsUnread}" Value="True">
                                    <Setter Property="FontWeight" Value="Bold"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn x:Name="ColStatus" Header=""
                                            Binding="{Binding Status}" Width="Auto"
                                            CanUserResize="False"/>
                        <DataGridTextColumn x:Name="ColFrom" Header="From"
                                            Binding="{Binding From}" Width="Auto"/>
                        <DataGridTextColumn x:Name="ColFromName" Header="From Name"
                                            Binding="{Binding FromName}" Width="Auto" Visibility="Collapsed"/>
                        <DataGridTextColumn x:Name="ColFromAddress" Header="From Address"
                                            Binding="{Binding FromAddress}" Width="Auto" Visibility="Collapsed"/>
                        <DataGridTextColumn x:Name="ColTo" Header="To"
                                            Binding="{Binding To}" Width="Auto"/>
                        <DataGridTextColumn x:Name="ColReceived" Header="Received"
                                            Binding="{Binding Received}" Width="Auto"
                                            SortMemberPath="ReceivedValue"/>
                        <DataGridTextColumn x:Name="ColSize" Header="KB"
                                            Binding="{Binding SizeKb}" Width="Auto"
                                            SortMemberPath="SizeVal">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextAlignment" Value="Right"/>
                                    <Setter Property="Margin" Value="0,0,6,0"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn x:Name="ColSubject" Header="Subject"
                                            Binding="{Binding Subject}" Width="*"/>
                    </DataGrid.Columns>
                    <DataGrid.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Reply" Click="OnReply"/>
                            <MenuItem Header="Reply all" Click="OnReplyAll"/>
                            <MenuItem Header="Forward" Click="OnForward"/>
                            <Separator/>
                            <MenuItem Header="Mark read" Click="OnMarkRead"/>
                            <MenuItem Header="Mark unread" Click="OnMarkUnread"/>
                            <MenuItem Header="Delete" InputGestureText="Del" Click="OnDeleteMessages"/>
                            <MenuItem x:Name="MoveToMenu" Header="Move to" SubmenuOpened="OnMoveToOpened">
                                <MenuItem Header="(loading…)"/>
                            </MenuItem>
                            <Separator/>
                            <MenuItem x:Name="ColumnsMenu" Header="Columns"/>
                        </ContextMenu>
                    </DataGrid.ContextMenu>
                </DataGrid>

                <GridSplitter Grid.Row="1" Height="5" HorizontalAlignment="Stretch"
                              VerticalAlignment="Center" ShowsPreview="True"/>

                <Grid Grid.Row="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBox x:Name="EnvelopeText" Grid.Row="0" IsReadOnly="True"
                             BorderThickness="0,1,0,1" FontFamily="Consolas"
                             TextWrapping="Wrap" MaxHeight="120"
                             VerticalScrollBarVisibility="Auto" Background="Transparent"/>
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="200"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*" MinWidth="200"/>
                        </Grid.ColumnDefinitions>
                        <TabControl x:Name="ReadingTabs" Grid.Column="0" BorderThickness="0">
                            <TabItem Header="Text">
                                <TextBox x:Name="BodyText" IsReadOnly="True" TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto" FontFamily="Consolas"
                                         BorderThickness="0"/>
                            </TabItem>
                            <TabItem Header="HTML">
                                <TextBox x:Name="HtmlSourceText" IsReadOnly="True" TextWrapping="NoWrap"
                                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                         FontFamily="Consolas" BorderThickness="0"/>
                            </TabItem>
                            <TabItem Header="Headers">
                                <TextBox x:Name="HeadersText" IsReadOnly="True" TextWrapping="NoWrap"
                                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                         FontFamily="Consolas" BorderThickness="0"/>
                            </TabItem>
                            <TabItem Header="MIME">
                                <TextBox x:Name="RawText" IsReadOnly="True" TextWrapping="NoWrap"
                                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                         FontFamily="Consolas" BorderThickness="0"/>
                            </TabItem>
                            <TabItem Header="Attachments">
                                <ListView x:Name="AttachmentList" BorderThickness="0"
                                          MouseDoubleClick="OnAttachmentSave"
                                          ToolTip="Double-click an attachment to save it">
                                    <ListView.View>
                                        <GridView>
                                            <GridViewColumn Header="Name" Width="260"
                                                            DisplayMemberBinding="{Binding Name}"/>
                                            <GridViewColumn Header="Type" Width="170"
                                                            DisplayMemberBinding="{Binding ContentType}"/>
                                            <GridViewColumn Header="KB" Width="70"
                                                            DisplayMemberBinding="{Binding SizeKb}"/>
                                            <GridViewColumn Header="Inline" Width="50"
                                                            DisplayMemberBinding="{Binding Inline}"/>
                                        </GridView>
                                    </ListView.View>
                                </ListView>
                            </TabItem>
                        </TabControl>
                        <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Center"
                                      VerticalAlignment="Stretch" ShowsPreview="True"/>
                        <wv2:WebView2 x:Name="PreviewView" Grid.Column="2"/>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>

        <StatusBar Grid.Row="2">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="Opening profile…"/>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="ScanLabel" Margin="0,0,12,0" VerticalAlignment="Center"
                               Foreground="Gray"/>
                    <TextBlock x:Name="SyncLabel" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <ProgressBar x:Name="SyncBar" Width="180" Height="14" VerticalAlignment="Center"/>
                    <Button x:Name="SyncButton" Content="Sync now" Margin="8,0,0,0"
                            Padding="8,1" Click="OnSyncClick"
                            AutomationProperties.AutomationId="cmd-sync"/>

                </StackPanel>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
