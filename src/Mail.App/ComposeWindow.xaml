<Window x:Class="Mail.App.ComposeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Compose" Height="640" Width="900" FontSize="12"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Text="From" Margin="0,4,8,4" VerticalAlignment="Center"/>
        <ComboBox x:Name="FromBox" Grid.Row="0" Grid.Column="1" Margin="0,2"/>

        <TextBlock Grid.Row="1" Grid.Column="0" Text="To" Margin="0,4,8,4" VerticalAlignment="Center"/>
        <TextBox x:Name="ToBox" Grid.Row="1" Grid.Column="1" Margin="0,2"
                 ToolTip="Comma or semicolon separated"/>

        <TextBlock Grid.Row="2" Grid.Column="0" Text="Cc" Margin="0,4,8,4" VerticalAlignment="Center"/>
        <TextBox x:Name="CcBox" Grid.Row="2" Grid.Column="1" Margin="0,2"/>

        <TextBlock Grid.Row="3" Grid.Column="0" Text="Bcc" Margin="0,4,8,4" VerticalAlignment="Center"/>
        <TextBox x:Name="BccBox" Grid.Row="3" Grid.Column="1" Margin="0,2"/>

        <TextBlock Grid.Row="4" Grid.Column="0" Text="Subject" Margin="0,4,8,4" VerticalAlignment="Center"/>
        <TextBox x:Name="SubjectBox" Grid.Row="4" Grid.Column="1" Margin="0,2"/>

        <StackPanel Grid.Row="5" Grid.Column="1" Orientation="Horizontal" Margin="0,4">
            <Button Content="Attach…" Padding="10,2" Click="OnAttach"/>
            <Button Content="Remove" Padding="10,2" Margin="4,0,0,0" Click="OnRemoveAttachment"/>
            <ListBox x:Name="AttachmentBox" Height="46" Width="620" Margin="8,0,0,0"
                     BorderThickness="1" DisplayMemberPath="Display"/>
        </StackPanel>

        <TextBox x:Name="BodyBox" Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="2"
                 Margin="0,6" AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto" FontFamily="Consolas"/>

        <DockPanel Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="2">
            <TextBlock x:Name="StatusText" DockPanel.Dock="Left" VerticalAlignment="Center"
                       Foreground="Gray"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="ShowSourceButton" Content="Show MIME" Padding="12,4"
                        Click="OnShowSource"
                        ToolTip="Preview exactly what will be sent"/>
                <Button x:Name="SendButton" Content="Send" Padding="20,4" Margin="8,0,0,0"
                        IsDefault="True" Click="OnSend"/>
                <Button Content="Cancel" Padding="16,4" Margin="8,0,0,0" IsCancel="True"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
