<Window x:Class="Mail.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Mail.App"
        Title="Settings" Height="700" Width="1080" FontSize="12"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <Style x:Key="Chip" TargetType="Border">
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="Padding" Value="5,1"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- One row per setting: label and provenance on the left, the editor
             for whichever kind it is on the right. -->
        <DataTemplate x:Key="SettingRow">
            <Border BorderBrush="{DynamicResource Chrome.BorderSubtle}" BorderThickness="0,0,0,1" Padding="6,7">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="240"/>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="56"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                            <Border Style="{StaticResource Chip}" Background="{Binding RiskBrush}"
                                    Visibility="{Binding RiskVisibility}">
                                <TextBlock Text="{Binding RiskLabel}" Foreground="White" FontSize="10"/>
                            </Border>
                            <Border Style="{StaticResource Chip}" Background="{DynamicResource Accent}"
                                    Visibility="{Binding OverriddenVisibility}">
                                <TextBlock Text="set here" Foreground="White" FontSize="10"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding Description}" TextWrapping="Wrap"
                                   Foreground="{DynamicResource Text.Secondary}" Margin="0,2,0,0"/>
                        <TextBlock Text="{Binding SourceText}" Foreground="{DynamicResource Text.Secondary}"
                                   FontSize="11" Margin="0,2,0,0"/>
                        <TextBlock Text="{Binding Warning}" TextWrapping="Wrap" Foreground="{DynamicResource Risk.Destructive}"
                                   Margin="0,3,0,0" Visibility="{Binding WarningVisibility}"/>
                        <TextBlock Text="{Binding KeyText}" FontFamily="Consolas" FontSize="10"
                                   Foreground="{DynamicResource Text.Secondary}" Margin="0,3,0,0"/>
                    </StackPanel>

                    <!-- Each editor is named after its setting. Generated rows
                         otherwise present as a wall of unnamed combo boxes to
                         both screen readers and UI automation, with no way to
                         tell which setting any of them belongs to. -->
                    <Grid Grid.Column="1" VerticalAlignment="Top" Margin="0,0,0,0">
                        <CheckBox IsChecked="{Binding BoolValue}" Click="OnValueChanged"
                                  Tag="{Binding Key}" VerticalAlignment="Center"
                                  Visibility="{Binding BoolVisibility}"
                                  Content="{Binding BoolCaption}"
                                  AutomationProperties.AutomationId="{Binding Key}"
                                  AutomationProperties.Name="{Binding Name}"
                                  AutomationProperties.HelpText="{Binding Description}"/>
                        <ComboBox ItemsSource="{Binding Choices}" SelectedItem="{Binding TextValue}"
                                  SelectionChanged="OnValueChanged" Tag="{Binding Key}"
                                  Visibility="{Binding ChoiceVisibility}"
                                  AutomationProperties.AutomationId="{Binding Key}"
                                  AutomationProperties.Name="{Binding Name}"
                                  AutomationProperties.HelpText="{Binding Description}"/>
                        <!-- Commit on focus loss, not per keystroke: a
                             PropertyChanged trigger writes back mid-edit, which
                             interleaves with the incoming text and can corrupt
                             the value (typing fast, or an automated SetValue,
                             turned "6" into "ser6"). -->
                        <TextBox Text="{Binding TextValue, UpdateSourceTrigger=LostFocus}"
                                 LostFocus="OnValueChanged" Tag="{Binding Key}"
                                 Visibility="{Binding TextVisibility}"
                                 AutomationProperties.AutomationId="{Binding Key}"
                                 AutomationProperties.Name="{Binding Name}"
                                 AutomationProperties.HelpText="{Binding Description}"/>
                    </Grid>

                    <Button Grid.Column="2" Content="Clear" Padding="8,2" Margin="8,0,0,0"
                            VerticalAlignment="Top" Click="OnClearOverride" Tag="{Binding Key}"
                            Visibility="{Binding OverriddenVisibility}"
                            AutomationProperties.AutomationId="{Binding ClearAutomationId}"
                            AutomationProperties.Name="{Binding ClearCaption}"
                            ToolTip="Remove the override set at this level so it inherits again."/>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="270"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Grid.Column="0">
            <TextBlock DockPanel.Dock="Top" Text="Applies to" FontWeight="SemiBold"
                       Margin="0,0,0,6"/>
            <TreeView x:Name="ScopeTree" SelectedItemChanged="OnScopeChanged"
                      BorderBrush="{DynamicResource Chrome.Border}" BorderThickness="1"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <TreeView.ItemContainerStyle>
                    <Style TargetType="TreeViewItem">
                        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=OneTime}"/>
                    </Style>
                </TreeView.ItemContainerStyle>
                <TreeView.Resources>
                    <HierarchicalDataTemplate DataType="{x:Type local:SettingsWindow+ScopeNode}"
                                              ItemsSource="{Binding Children}">
                        <TextBlock Text="{Binding Label}" Padding="1,2"
                                   TextWrapping="Wrap" MaxWidth="210"
                                   ToolTip="{Binding Hint}"/>
                    </HierarchicalDataTemplate>
                </TreeView.Resources>
            </TreeView>
        </DockPanel>

        <GridSplitter Grid.Row="0" Grid.Column="1" Width="6" HorizontalAlignment="Center"
                      VerticalAlignment="Stretch" Background="Transparent"/>

        <DockPanel Grid.Row="0" Grid.Column="2">
            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                <TextBlock x:Name="ScopeHeader" FontWeight="SemiBold" FontSize="14"/>
                <TextBlock x:Name="ScopeHint" Foreground="{DynamicResource Text.Secondary}" TextWrapping="Wrap"
                           Margin="0,2,0,0"/>
            </StackPanel>

            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                <TextBlock Text="Filter:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <CheckBox x:Name="OnlyOverridden" Content="Only settings changed here"
                          DockPanel.Dock="Right" VerticalAlignment="Center"
                          Click="OnFilterChanged" Margin="8,0,0,0"/>
                <TextBox x:Name="FilterBox" TextChanged="OnFilterChanged"/>
            </DockPanel>

            <!-- Actions live above the settings list, not in a separate window:
                 an account node has things to do (grant permissions, add a
                 shared mailbox) as well as values to set, and splitting those
                 across two dialogs is what made the old Accounts window a
                 parallel place to look. -->
            <Border x:Name="ActionsPanel" DockPanel.Dock="Top" Visibility="Collapsed"
                    BorderBrush="{DynamicResource Chrome.Border}" BorderThickness="1" Padding="8" Margin="0,0,0,8"
                    Background="{DynamicResource Chrome.Alt}">
                <StackPanel>
                    <TextBlock x:Name="ActionsHeader" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <ItemsControl x:Name="ActionsList">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding Label}" Tag="{Binding Id}"
                                        Click="OnActionClick" Padding="10,3" Margin="0,0,8,4"
                                        ToolTip="{Binding Hint}"
                                        AutomationProperties.AutomationId="{Binding Id}"
                                        AutomationProperties.Name="{Binding Label}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock x:Name="ActionsDetail" Foreground="{DynamicResource Text.Secondary}" TextWrapping="Wrap"
                               Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <ScrollViewer VerticalScrollBarVisibility="Auto" BorderBrush="{DynamicResource Chrome.Border}"
                          BorderThickness="1" Padding="6,0,6,6">
                <ItemsControl x:Name="SettingsList">
                    <ItemsControl.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" FontWeight="Bold"
                                               Foreground="{DynamicResource Text.Primary}" FontSize="13"
                                               Margin="0,12,0,4" Padding="0,4,0,0"/>
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ItemsControl.GroupStyle>
                    <ItemsControl.ItemTemplate>
                        <StaticResource ResourceKey="SettingRow"/>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>

        <DockPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,8,0,0">
            <TextBlock x:Name="StatusLabel" VerticalAlignment="Center" Foreground="{DynamicResource Text.Secondary}"
                       TextTrimming="CharacterEllipsis"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Close" Padding="14,3" Click="OnClose"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
