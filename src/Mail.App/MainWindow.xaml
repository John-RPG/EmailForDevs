<Window x:Class="Mail.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:local="clr-namespace:Mail.App"
        xmlns:avalon="https://github.com/Dirkster99/AvalonDock"
        Title="eeeMail (dev)" Height="850" Width="1500" FontSize="12"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
                    
                        <Style x:Key="FolderRowStyle" TargetType="TreeViewItem">
                            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
                            <Setter Property="Visibility" Value="{Binding Visibility}"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                            <Setter Property="Padding" Value="1,1"/>
                            <!--
                              The stock TreeViewItem template sizes its header to
                              content, so a Stretch on the row alone never reaches
                              the item. Retemplating gives the header a real column
                              that fills the remaining width, which is what lets the
                              count column sit hard right and the name ellipsize.
                            -->
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="TreeViewItem">
                                        <StackPanel>
                                            <Border x:Name="Row"
                                                    Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    Padding="{TemplateBinding Padding}"
                                                    SnapsToDevicePixels="True">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="19"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <ToggleButton x:Name="Expander" Grid.Column="0"
                                                                  ClickMode="Press"
                                                                  IsChecked="{Binding IsExpanded,
                                                                      RelativeSource={RelativeSource TemplatedParent}}">
                                                        <ToggleButton.Style>
                                                            <Style TargetType="ToggleButton">
                                                                <Setter Property="Focusable" Value="False"/>
                                                                <Setter Property="Width" Value="16"/>
                                                                <Setter Property="Height" Value="16"/>
                                                                <Setter Property="Template">
                                                                    <Setter.Value>
                                                                        <ControlTemplate TargetType="ToggleButton">
                                                                            <Border Background="Transparent"
                                                                                    Width="16" Height="16">
                                                                                <Path x:Name="Arrow"
                                                                                      HorizontalAlignment="Center"
                                                                                      VerticalAlignment="Center"
                                                                                      Data="M 0 0 L 4 4 L 0 8 Z"
                                                                                      Fill="#FF666666"/>
                                                                            </Border>
                                                                            <ControlTemplate.Triggers>
                                                                                <Trigger Property="IsChecked" Value="True">
                                                                                    <Setter TargetName="Arrow"
                                                                                            Property="Data"
                                                                                            Value="M 0 2 L 8 2 L 4 6 Z"/>
                                                                                </Trigger>
                                                                            </ControlTemplate.Triggers>
                                                                        </ControlTemplate>
                                                                    </Setter.Value>
                                                                </Setter>
                                                            </Style>
                                                        </ToggleButton.Style>
                                                    </ToggleButton>
                                                    <ContentPresenter x:Name="PART_Header" Grid.Column="1"
                                                                      ContentSource="Header"
                                                                      HorizontalAlignment="Stretch"/>
                                                </Grid>
                                            </Border>
                                            <ItemsPresenter x:Name="ItemsHost" Margin="12,0,0,0"/>
                                        </StackPanel>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsExpanded" Value="False">
                                                <Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed"/>
                                            </Trigger>
                                            <Trigger Property="HasItems" Value="False">
                                                <Setter TargetName="Expander" Property="Visibility" Value="Hidden"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Row" Property="Background" Value="#FF0078D7"/>
                                                <Setter Property="Foreground" Value="White"/>
                                            </Trigger>
                                            <MultiTrigger>
                                                <MultiTrigger.Conditions>
                                                    <Condition Property="IsMouseOver" Value="True"/>
                                                    <Condition Property="IsSelected" Value="False"/>
                                                </MultiTrigger.Conditions>
                                                <Setter TargetName="Row" Property="Background" Value="#FFE5F3FB"/>
                                            </MultiTrigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    
                    
                        <HierarchicalDataTemplate x:Key="FolderRowTemplate" ItemsSource="{Binding Children}">
                            <Grid Background="Transparent" ToolTip="{Binding Tooltip}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <!-- Auto, not a shared size group. A shared group
                                         makes every row reserve the widest row's number
                                         column, so a folder with no counts still lost
                                         ~100px and truncated its name for nothing. The
                                         cells collapse when empty (see NumberVisibility),
                                         which hands the space back to the name. -->
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Icon}" Margin="0,0,5,0"
                                           VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding DisplayName}"
                                           TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center"
                                           FontWeight="{Binding Weight}"/>
                                <TextBlock Grid.Column="2" Text="{Binding Totals}"
                                           Foreground="{DynamicResource Text.Secondary}"
                                           VerticalAlignment="Center"
                                           TextAlignment="Right" Margin="8,0,0,0"
                                           Visibility="{Binding TotalsVisibility}"/>
                                <TextBlock Grid.Column="3" Text="{Binding Counts}"
                                           Foreground="{Binding CountBrush}"
                                           FontWeight="{Binding Weight}"
                                           VerticalAlignment="Center"
                                           TextAlignment="Right" MinWidth="30" Margin="6,0,4,0"
                                           Visibility="{Binding CountsVisibility}"/>
                                <Grid.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Add to favourites" Click="OnAddFavourite"/>
                                        <MenuItem Header="Remove from favourites" Click="OnRemoveFavourite"/>
                                        <Separator/>
                                        <MenuItem Header="Expand all" Click="OnExpandAll"/>
                                        <MenuItem Header="Collapse all" Click="OnCollapseAll"/>
                                    </ContextMenu>
                                </Grid.ContextMenu>
                            </Grid>
                        </HierarchicalDataTemplate>
                    
    </Window.Resources>
    <Window.InputBindings>
        <KeyBinding Key="N" Modifiers="Ctrl" Command="{x:Static local:MainWindow.ComposeCommand}"/>
        <KeyBinding Key="R" Modifiers="Ctrl" Command="{x:Static local:MainWindow.ReplyCommand}"/>
        <KeyBinding Key="R" Modifiers="Ctrl+Shift" Command="{x:Static local:MainWindow.ReplyAllCommand}"/>
        <KeyBinding Key="F" Modifiers="Ctrl" Command="{x:Static local:MainWindow.ForwardCommand}"/>
        <KeyBinding Key="Delete" Command="{x:Static local:MainWindow.DeleteCommand}"/>
        <KeyBinding Key="Q" Modifiers="Ctrl" Command="{x:Static local:MainWindow.MarkReadCommand}"/>
        <KeyBinding Key="U" Modifiers="Ctrl" Command="{x:Static local:MainWindow.MarkUnreadCommand}"/>
        <KeyBinding Key="F5" Command="{x:Static local:MainWindow.SyncCommand}"/>
        <KeyBinding Key="OemComma" Modifiers="Ctrl" Command="{x:Static local:MainWindow.SettingsCommand}"/>
        <KeyBinding Key="E" Modifiers="Ctrl" Command="{x:Static local:MainWindow.FocusSearchCommand}"/>
    </Window.InputBindings>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="4,4,4,2">
            <!-- Compose actions, then actions on the selected message. Delete,
                 mark read and move were reachable only from the context menu,
                 so a new user could not find them at all. -->
            <Button DockPanel.Dock="Left" Content="New" Click="OnComposeNew"
                    Margin="0,0,4,0" Padding="12,2" ToolTip="New message (Ctrl+N)"
                    AutomationProperties.AutomationId="cmd-new"/>
            <Button DockPanel.Dock="Left" Content="Reply" Click="OnReply"
                    Margin="0,0,4,0" Padding="10,2" ToolTip="Reply (Ctrl+R)"
                    AutomationProperties.AutomationId="cmd-reply"/>
            <Button DockPanel.Dock="Left" Content="Reply all" Click="OnReplyAll"
                    Margin="0,0,4,0" Padding="10,2" ToolTip="Reply all (Ctrl+Shift+R)"
                    AutomationProperties.AutomationId="cmd-replyall"/>
            <Button DockPanel.Dock="Left" Content="Forward" Click="OnForward"
                    Margin="0,0,10,0" Padding="10,2" ToolTip="Forward (Ctrl+F)"
                    AutomationProperties.AutomationId="cmd-forward"/>

            <Button x:Name="DraftsButton" DockPanel.Dock="Left" Content="Drafts"
                    Click="OnDraftsClick" Margin="0,0,10,0" Padding="10,2"
                    Visibility="Collapsed"
                    ToolTip="Unsent messages saved on this machine"
                    AutomationProperties.AutomationId="cmd-drafts"/>

            <Separator DockPanel.Dock="Left" Margin="0,2,10,2"/>

            <Button DockPanel.Dock="Left" Content="Delete" Click="OnDeleteMessages"
                    Margin="0,0,4,0" Padding="10,2"
                    ToolTip="Move to Deleted Items (Del)"
                    AutomationProperties.AutomationId="cmd-delete"/>
            <Button DockPanel.Dock="Left" Content="Read" Click="OnMarkRead"
                    Margin="0,0,4,0" Padding="10,2" ToolTip="Mark as read (Ctrl+Q)"
                    AutomationProperties.AutomationId="cmd-read"/>
            <Button DockPanel.Dock="Left" Content="Unread" Click="OnMarkUnread"
                    Margin="0,0,10,0" Padding="10,2" ToolTip="Mark as unread (Ctrl+U)"
                    AutomationProperties.AutomationId="cmd-unread"/>

            <Button DockPanel.Dock="Right" Content="Search" Click="OnSearchClick"
                    Margin="4,0,0,0" Padding="10,2"
                    AutomationProperties.AutomationId="cmd-search"/>
            <Button x:Name="SettingsButton" DockPanel.Dock="Right" Content="Settings…"
                    Click="OnSettingsClick" Margin="4,0,0,0" Padding="10,2"
                    ToolTip="Accounts, permissions, sync and display settings (Ctrl+,)"
                    AutomationProperties.AutomationId="cmd-settings"/>
            <TextBox x:Name="SearchBox" KeyDown="OnSearchKeyDown"
                     VerticalContentAlignment="Center"
                     AutomationProperties.Name="Search">
                <TextBox.ToolTip>
                    <TextBlock>
                        Search (Enter). Bare words are full text; empty returns to the folder.<LineBreak/>
                        <LineBreak/>
                        <Bold>People</Bold>  from: to: cc: bcc: recipient: participant:<LineBreak/>
                        <Bold>Content</Bold>  subject: body: filename: in:<LineBreak/>
                        <Bold>State</Bold>  is:unread is:read is:flagged is:draft has:attachment<LineBreak/>
                        <Bold>Dates</Bold>  after: before: on:  — 2026-08-31, 2026-08, today, 7d, 3m<LineBreak/>
                        <Bold>Size</Bold>  larger:2mb smaller:500kb<LineBreak/>
                        <Bold>Logic</Bold>  AND (implicit), OR, NOT or -, ( ), "quoted phrases"<LineBreak/>
                        <Bold>Wildcards</Bold>  * and ? in field values (anchored: from:*@corp.com,<LineBreak/>
                        filename:*.pdf, subject:*report*); trailing * on bare words (invoic*).<LineBreak/>
                        Escape with a backslash for literals: \* \? \\<LineBreak/>
                        <LineBreak/>
                        Example: from:alice has:attachment after:3m -subject:"weekly report"
                    </TextBlock>
                </TextBox.ToolTip>
            </TextBox>
        </DockPanel>

        <avalon:DockingManager x:Name="Dock" Grid.Row="1"
                               Background="{DynamicResource Chrome.Background}"
                               DocumentPaneMenuItemHeaderTemplate="{x:Null}"
                               AllowMixedOrientation="True">
            <avalon:LayoutRoot>
              <!-- One root panel: LayoutRoot accepts a single child, so the
                   horizontal split and the log strip nest inside it. -->
              <avalon:LayoutPanel Orientation="Vertical">
                <avalon:LayoutPanel Orientation="Horizontal" DockHeight="*">

                    <!-- Left: favourites, folders, activity log. Anchorables
                         rather than documents, so each can be floated onto a
                         second monitor or hidden entirely. -->
                    <avalon:LayoutAnchorablePane DockWidth="280">
                        <avalon:LayoutAnchorable Title="Folders" ContentId="folders"
                                                 CanClose="False" CanHide="True">
                            <DockPanel>
                                <StackPanel xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" DockPanel.Dock="Top" Orientation="Horizontal" Margin="4,2">
                    <ToggleButton x:Name="HideQuietToggle" Content="Hide quiet" Padding="6,1" Click="OnHideQuietChanged" ToolTip="Hide folders with nothing received in the last month (favourites and folders with unread mail always stay)" />
                    <Button Content="Expand" Padding="6,1" Margin="4,0,0,0" Click="OnExpandAll" />
                    <Button Content="Collapse" Padding="6,1" Margin="4,0,0,0" Click="OnCollapseAll" />
                </StackPanel>
                                <TextBlock xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Name="FavouritesHeader" DockPanel.Dock="Top" Text="  ★ Favourites" Background="{DynamicResource Chrome.Alt}" Foreground="{DynamicResource Text.Secondary}" Padding="2,3" FontWeight="Bold" Visibility="Collapsed" />
                                <TreeView xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Name="FavouritesTree" DockPanel.Dock="Top" SelectedItemChanged="OnFavouriteSelected" BorderThickness="0,1,0,0" Grid.IsSharedSizeScope="True" MaxHeight="220" Visibility="Collapsed" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Center" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ItemContainerStyle="{DynamicResource FolderRowStyle}" ItemTemplate="{DynamicResource FolderRowTemplate}" />
                                <TreeView xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Name="FolderTree"  SelectedItemChanged="OnFolderSelected" BorderThickness="0,1,0,0" ItemContainerStyle="{DynamicResource FolderRowStyle}" ItemTemplate="{DynamicResource FolderRowTemplate}" Grid.IsSharedSizeScope="True" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Center" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
                            </DockPanel>
                        </avalon:LayoutAnchorable>
                    </avalon:LayoutAnchorablePane>

                    <!-- Centre: the message list over the reader, as documents
                         so they cannot be closed away by accident. -->
                    <avalon:LayoutPanel Orientation="Vertical" DockWidth="*">
                        <avalon:LayoutDocumentPane DockHeight="3*" DockMinHeight="150">
                            <avalon:LayoutDocument Title="Messages" ContentId="messages"
                                                   CanClose="False" CanFloat="True">
                                <DataGrid xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Name="MessageGrid"  AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Extended" SelectionUnit="FullRow" GridLinesVisibility="None" RowHeaderWidth="0" BorderThickness="0,1,0,0" HeadersVisibility="Column" EnableRowVirtualization="True" VirtualizingPanel.VirtualizationMode="Recycling" CanUserAddRows="False" CanUserDeleteRows="False" SelectionChanged="OnMessageSelected" PreviewKeyDown="OnGridKeyDown">
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsUnread}" Value="True">
                                    <Setter Property="FontWeight" Value="Bold" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn x:Name="ColStatus" Header="" Binding="{Binding Status}" Width="Auto" CanUserResize="False" />
                        <DataGridTextColumn x:Name="ColFrom" Header="From" Binding="{Binding From}" Width="Auto" />
                        <DataGridTextColumn x:Name="ColFromName" Header="From Name" Binding="{Binding FromName}" Width="Auto" Visibility="Collapsed" />
                        <DataGridTextColumn x:Name="ColFromAddress" Header="From Address" Binding="{Binding FromAddress}" Width="Auto" Visibility="Collapsed" />
                        <DataGridTextColumn x:Name="ColTo" Header="To" Binding="{Binding To}" Width="Auto" />
                        <DataGridTextColumn x:Name="ColReceived" Header="Received" Binding="{Binding Received}" Width="Auto" SortMemberPath="ReceivedValue" FontFamily="Consolas"/>
                        <DataGridTextColumn x:Name="ColSize" Header="KB" Binding="{Binding SizeKb}" Width="Auto" SortMemberPath="SizeVal">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextAlignment" Value="Right"/>
                                    <Setter Property="Margin" Value="0,0,6,0" />
                                    <!-- Monospace digits so figures line up
                                         column-wise and can be compared at a
                                         glance; proportional digits do not. -->
                                    <Setter Property="FontFamily" Value="Consolas"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn x:Name="ColSubject" Header="Subject" Binding="{Binding Subject}" Width="*" />
                    </DataGrid.Columns>
                    <DataGrid.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Reply" Click="OnReply" />
                            <MenuItem Header="Reply all" Click="OnReplyAll" />
                            <MenuItem Header="Forward" Click="OnForward" />
                            <Separator />
                            <MenuItem Header="Mark read" Click="OnMarkRead" />
                            <MenuItem Header="Mark unread" Click="OnMarkUnread" />
                            <MenuItem Header="Delete" InputGestureText="Del" Click="OnDeleteMessages" />
                            <MenuItem x:Name="MoveToMenu" Header="Move to" SubmenuOpened="OnMoveToOpened">
                                <MenuItem Header="(loading…)" />
                            </MenuItem>
                            <Separator />
                            <MenuItem x:Name="ColumnsMenu" Header="Columns" />
                        </ContextMenu>
                    </DataGrid.ContextMenu>
                </DataGrid>
                            </avalon:LayoutDocument>
                        </avalon:LayoutDocumentPane>

                        <avalon:LayoutAnchorablePane DockHeight="4*" DockMinHeight="220">
                            <avalon:LayoutAnchorable Title="Reading pane" ContentId="reader"
                                                     CanClose="False" CanHide="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBox x:Name="EnvelopeText" Grid.Row="0" IsReadOnly="True"
                             BorderThickness="0,1,0,1" FontFamily="Consolas"
                             TextWrapping="Wrap" MaxHeight="120"
                             VerticalScrollBarVisibility="Auto" Background="Transparent"/>
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="200"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*" MinWidth="200"/>
                        </Grid.ColumnDefinitions>
                        <TabControl x:Name="ReadingTabs" Grid.Column="0" BorderThickness="0">
                            <TabItem Header="Text">
                                <TextBox x:Name="BodyText" IsReadOnly="True" TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto" FontFamily="Consolas"
                                         BorderThickness="0"/>
                            </TabItem>
                            <TabItem Header="HTML">
                                <TextBox x:Name="HtmlSourceText" IsReadOnly="True" TextWrapping="NoWrap"
                                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                         FontFamily="Consolas" BorderThickness="0"/>
                            </TabItem>
                            <TabItem Header="Headers">
                                <TextBox x:Name="HeadersText" IsReadOnly="True" TextWrapping="NoWrap"
                                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                         FontFamily="Consolas" BorderThickness="0"/>
                            </TabItem>
                            <TabItem Header="MIME">
                                <TextBox x:Name="RawText" IsReadOnly="True" TextWrapping="NoWrap"
                                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                         FontFamily="Consolas" BorderThickness="0"/>
                            </TabItem>
                            <TabItem Header="Attachments">
                                <DockPanel>
                                    <DockPanel DockPanel.Dock="Top" Margin="4">
                                        <CheckBox x:Name="ShowInlineBox" Content="Show inline parts"
                                                  VerticalAlignment="Center" Margin="0,0,12,0"
                                                  Click="OnToggleInline"
                                                  ToolTip="Inline parts are images embedded in the message body — usually logos and signature graphics rather than files anyone meant to send."
                                                  AutomationProperties.AutomationId="attach-showinline"/>
                                        <Button DockPanel.Dock="Right" Content="Export all…"
                                                Padding="10,2" Click="OnExportAllAttachments"
                                                ToolTip="Save every listed attachment to a folder"
                                                AutomationProperties.AutomationId="attach-exportall"/>
                                        <Button DockPanel.Dock="Right" Content="Save…" Margin="0,0,6,0"
                                                Padding="10,2" Click="OnSaveSelectedAttachment"
                                                ToolTip="Save the selected attachment"
                                                AutomationProperties.AutomationId="attach-save"/>
                                        <Button x:Name="OpenAttachmentButton" DockPanel.Dock="Right"
                                                Content="Open" Margin="0,0,6,0" Padding="10,2"
                                                Click="OnOpenAttachment" Visibility="Collapsed"
                                                ToolTip="Open in the associated application"
                                                AutomationProperties.AutomationId="attach-open"/>
                                        <TextBlock x:Name="AttachmentSummary" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource Text.Secondary}"/>
                                    </DockPanel>

                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*" MinHeight="80"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="2*"/>
                                        </Grid.RowDefinitions>

                                        <ListView x:Name="AttachmentList" Grid.Row="0" BorderThickness="0"
                                                  MouseDoubleClick="OnAttachmentSave"
                                                  SelectionChanged="OnAttachmentSelected"
                                                  ToolTip="Double-click an attachment to save it">
                                            <ListView.View>
                                                <GridView>
                                                    <GridViewColumn Header="Name" Width="240"
                                                                    DisplayMemberBinding="{Binding Name}"/>
                                                    <GridViewColumn Header="Type" Width="160"
                                                                    DisplayMemberBinding="{Binding ContentType}"/>
                                                    <GridViewColumn Header="KB" Width="70"
                                                                    DisplayMemberBinding="{Binding SizeKb}"/>
                                                    <GridViewColumn Header="Inline" Width="50"
                                                                    DisplayMemberBinding="{Binding Inline}"/>
                                                </GridView>
                                            </ListView.View>
                                        </ListView>

                                        <GridSplitter Grid.Row="1" Height="5" HorizontalAlignment="Stretch"
                                                      VerticalAlignment="Center" ShowsPreview="True"/>

                                        <Border Grid.Row="2" BorderBrush="{DynamicResource Chrome.Border}" BorderThickness="0,1,0,0">
                                            <Grid>
                                                <TextBlock x:Name="AttachmentPreviewHint"
                                                           Text="Select an attachment to preview it."
                                                           Foreground="{DynamicResource Text.Secondary}" Margin="8"
                                                           VerticalAlignment="Top"/>
                                                <Image x:Name="AttachmentImage" Margin="6"
                                                       Stretch="Uniform" StretchDirection="DownOnly"
                                                       Visibility="Collapsed"/>
                                                <TextBox x:Name="AttachmentText" Margin="0"
                                                         IsReadOnly="True" BorderThickness="0"
                                                         FontFamily="Consolas" FontSize="11"
                                                         VerticalScrollBarVisibility="Auto"
                                                         HorizontalScrollBarVisibility="Auto"
                                                         Visibility="Collapsed"/>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </DockPanel>
                            </TabItem>
                        </TabControl>
                        <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Center"
                                      VerticalAlignment="Stretch" ShowsPreview="True"/>
                        <wv2:WebView2 x:Name="PreviewView" Grid.Column="2"/>
                    </Grid>
                </Grid>
                            </avalon:LayoutAnchorable>
                        </avalon:LayoutAnchorablePane>
                    </avalon:LayoutPanel>

                </avalon:LayoutPanel>

                <!-- Bottom: the activity log, in its own strip below both. -->
                <avalon:LayoutAnchorablePaneGroup Orientation="Horizontal" DockHeight="140" DockMinHeight="80">
                    <avalon:LayoutAnchorablePane>
                        <avalon:LayoutAnchorable Title="Activity log" ContentId="log"
                                                 CanClose="False" CanHide="True">
                            <DockPanel xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="2">
                            <ToggleButton x:Name="FltDebug" Content="⚙" ToolTip="Debug" Padding="6,0" Margin="1,0" Click="OnLogFilterChanged" />
                            <ToggleButton x:Name="FltVerbose" Content="·" ToolTip="Verbose" IsChecked="True" Padding="8,0" Margin="1,0" Click="OnLogFilterChanged" />
                            <ToggleButton x:Name="FltInfo" Content="ℹ" ToolTip="Info" IsChecked="True" Padding="7,0" Margin="1,0" Click="OnLogFilterChanged" />
                            <ToggleButton x:Name="FltWarning" Content="⚠" ToolTip="Warning" IsChecked="True" Padding="6,0" Margin="1,0" Click="OnLogFilterChanged" />
                            <ToggleButton x:Name="FltError" Content="✖" ToolTip="Error" IsChecked="True" Padding="6,0" Margin="1,0" Click="OnLogFilterChanged" />
                            <Button Content="Clear" Margin="8,0,0,0" Padding="6,0" Click="OnLogClear" />
                        </StackPanel>
                        <ListBox x:Name="ActivityLog" MinHeight="60" FontFamily="Consolas" FontSize="11" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Auto">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="2,0" />
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Display}" Foreground="{Binding Brush}" ToolTip="{Binding Message}" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                        </avalon:LayoutAnchorable>
                    </avalon:LayoutAnchorablePane>
                </avalon:LayoutAnchorablePaneGroup>
              </avalon:LayoutPanel>
            </avalon:LayoutRoot>
        </avalon:DockingManager>

        <StatusBar Grid.Row="2">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="Opening profile…"/>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="ScanLabel" Margin="0,0,12,0" VerticalAlignment="Center"
                               Foreground="{DynamicResource Text.Secondary}"/>
                    <TextBlock x:Name="SyncLabel" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <ProgressBar x:Name="SyncBar" Width="180" Height="14" VerticalAlignment="Center"/>
                    <Button x:Name="SyncButton" Content="Sync now" Margin="8,0,0,0"
                            Padding="8,1" Click="OnSyncClick"
                            AutomationProperties.AutomationId="cmd-sync"/>

                </StackPanel>
            </StatusBarItem>
        </StatusBar>
    </Grid>
